# Telegram Bot Token (@BotFather orqali olingan token)
BOT_TOKEN=your_telegram_bot_token_here

# Mini App manzili (Web App URL - masalan ngrok manzili yoki server domeni)
WEBAPP_URL=http://localhost:3000

# Server porti
PORT=3000

# Maktab nomi
SCHOOL_NAME=65-umumiy o'rta ta'lim maktabi

# Rejali xabarnoma yuborish jadvali (Dushanba-Shanba, soat 14:00)
# Cron formati: daqiqa soat kun oy hafta_kuni
CRON_SCHEDULE=0 14 * * 1-6

# Xabarlar oralig'idagi kechikish (millisekundda, Telegram flood limitdan himoya uchun)
MESSAGE_DELAY_MS=50
