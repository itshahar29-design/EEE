# Telegram Bot Token (@BotFather orqali olingan token)
BOT_TOKEN=your_telegram_bot_token_here

# Mini App manzili (Web App URL - Render domeni)
WEBAPP_URL=https://eee-w2yj.onrender.com

# Server porti (Render avtomatik beradi)
PORT=3000

# Maktab nomi
SCHOOL_NAME=65-umumiy o'rta ta'lim maktabi

# O'qituvchilar uchun 4 xonali PIN-kod (standart: 6565)
TEACHER_PIN=6565

# PostgreSQL ulanish manzili (ixtiyoriy, berilsa PostgreSQL, berilmasa SQLite ishlatiladi)
DATABASE_URL=

# Rejali xabarnoma yuborish jadvali (Dushanba-Shanba soat 14:00)
CRON_SCHEDULE=0 14 * * 1-6

# Telegram flood limitdan himoyalanish kechikishi (ms)
MESSAGE_DELAY_MS=50
