# Telegram Bot Token (@BotFather orqali olingan token)
BOT_TOKEN=your_telegram_bot_token_here

# Mini App manzili (Web App URL - Render domeni)
WEBAPP_URL=https://eee-w2yj.onrender.com

# Server porti (Render avtomatik beradi)
PORT=3000

# Vaqt zonasi (O'zbekiston)
TZ=Asia/Tashkent

# Maktab nomi
SCHOOL_NAME=65-umumiy o'rta ta'lim maktabi

# Xavfsizlik PIN-kodlari:
# 1. O'qituvchilar uchun PIN-kod (faqat 08:00 - 13:30 davomat belgilash uchun)
TEACHER_PIN=6565

# 2. Maktab ma'muriyati (Direktor / Zavuch) PIN-kodi (barcha sinflar nazorati va Excel uchun)
ADMIN_PIN=9900

# Maktab ma'muriyatining Telegram Chat ID si (davomat qilinmagan sinflar haqida ogohlantirish yuborish uchun)
ADMIN_CHAT_ID=

# PostgreSQL ulanish manzili (ixtiyoriy, berilsa PostgreSQL, berilmasa SQLite ishlatiladi)
DATABASE_URL=

# Rejali xabarnoma yuborish jadvali (Dushanba-Shanba soat 14:00 da)
CRON_SCHEDULE=0 14 * * 1-6

# Telegram flood limitdan himoyalanish kechikishi (ms)
MESSAGE_DELAY_MS=50
